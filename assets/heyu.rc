#pragma code_page(65001)
// HEYU Windows resource script (ASCII-safe for all windres/llvm-rc toolchains).
// Icons are generated by assets/make_icon.py.

#include <winver.h>

1 ICON "heyu.ico"
2 ICON "tray_light.ico"
3 ICON "tray_dark.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     1,0,0,0
 PRODUCTVERSION  1,0,0,0
 FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
 FILEFLAGS       0x0L
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_APP
 FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "HEYU Input Method Studio"
            VALUE "FileDescription",  "HEYU Offline Desktop Input Method & Voice Assistant"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "heyu-ime"
            VALUE "LegalCopyright",   "Copyright (c) 2026 HEYU Open Source (MIT)"
            VALUE "OriginalFilename", "heyu-ime.exe"
            VALUE "ProductName",      "HEYU Input Method (YinXing & Offline Voice)"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END

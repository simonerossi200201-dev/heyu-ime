{
  "_comment": "Provenance manifest for tools/make_release.ps1. Every tracked file must match exactly one class. Patterns use PowerShell -like on repo-relative paths with forward slashes ('*' also spans '/'). Unclassified tracked files make the release FAIL. See docs/LICENSING.md.",
  "restricted": [
    { "pattern": "data/heyu_sys.tsv", "reason": "derived from amorphobia/openfly = 小鹤音形 official lexicon (小鹤音形 EULA) + NC lexicons" },
    { "pattern": "data/heyu_reverse.tsv", "reason": "derived from the same openfly / 小鹤音形 tables" },
    { "pattern": "data/shuangpin_shape_hints.tsv", "reason": "generated from data/heyu_sys.tsv + heyu_reverse.tsv (restricted)" },
    { "pattern": "data/flypy_*", "reason": "legacy names of the same restricted tables" },
    { "pattern": "data/root_atlas.json", "reason": "小鹤 字根 key assignment + examples generated from the restricted table" },
    { "pattern": "data/private/*", "reason": "user-imported private tables" },
    { "pattern": "tools/heyu_facts.py", "reason": "embeds the 小鹤 字根 key table" },
    { "pattern": "tools/gen_manual.py", "reason": "embeds 小鹤 splitting-rule prose; renders the restricted table" },
    { "pattern": "tools/audit_manual.py", "reason": "audits the restricted manual; imports heyu_facts" },
    { "pattern": "tools/raw_sources/*", "reason": "raw openfly / rime-flypy downloads" },
    { "pattern": "*完全指南*.md", "reason": "manual generated from the restricted table (字根 tables, example codes)" }
  ],
  "personal": [
    { "pattern": "data/user_custom.tsv", "reason": "owner's personal phrases (replaced by data/examples/user_custom.example.tsv)" },
    { "pattern": "data/config.json", "reason": "owner's UI positions / preferences (engine defaults apply when absent)" },
    { "pattern": "data/telemetry.json", "reason": "local typing statistics" },
    { "pattern": "data/crash.log", "reason": "local crash log" },
    { "pattern": "*studio.log", "reason": "local log" },
    { "pattern": "data/security_audit_report.json", "reason": "machine-specific paths and hashes (regenerate with tools/security_audit.py)" },
    { "pattern": "data/tsf_registered.marker", "reason": "machine state written by install.ps1" },
    { "pattern": "data/input_history.*", "reason": "encrypted local auto-expiring input history vault" },
    { "pattern": "data/.vault_key", "reason": "machine-local vault secret key" },
    { "pattern": "data/tmp_*", "reason": "temporary studio recorder / transcription staging files" },
    { "pattern": "data/voice_stream.jsonl", "reason": "local live transcription stream bus" },
    { "pattern": "data/dual_cursor_sink.json", "reason": "local dual-cursor workbench state" },
    { "pattern": "data/voice_config.json", "reason": "owner's local voice config preferences" }
  ],
  "distributable": [
